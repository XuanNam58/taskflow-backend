{
  "info": {
    "name": "TaskFlow — Auth",
    "description": "Auth flow for taskflow-backend.\n\nThe refresh token lives in an httpOnly cookie (`refresh_token`, Path=/api/auth). Postman's cookie jar stores it on Login and sends it automatically to /refresh and /logout, exactly like a browser. Only the access token is kept in a collection variable.\n\nRun the whole collection with the Collection Runner, top to bottom. Uncheck the 'Manual (not for Runner)' folder: it needs a restarted app.\n\nRequires the app running on localhost:8080 with APP_JWT_SECRET set (at least 32 characters).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "currentRefreshToken",
      "value": ""
    },
    {
      "key": "oldRefreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Session",
      "description": "Register, Login, use the access token, rotate the refresh token.",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/api/auth/register",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nam@example.com\",\n  \"username\": \"xuannam\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registers or reports a conflict', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/api/auth/login",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nam@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('refresh token is not in the body', function () {",
                  "    pm.expect(pm.response.json()).to.not.have.property('refreshToken');",
                  "});",
                  "",
                  "pm.test('refresh cookie has the security attributes', function () {",
                  "    const header = pm.response.headers.get('Set-Cookie');",
                  "    pm.expect(header).to.include('refresh_token=');",
                  "    pm.expect(header).to.include('HttpOnly');",
                  "    pm.expect(header).to.include('Secure');",
                  "    pm.expect(header).to.include('SameSite=Strict');",
                  "    pm.expect(header).to.include('Path=/api/auth');",
                  "});",
                  "",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('currentRefreshToken', (pm.response.headers.get('Set-Cookie') || '').match(/refresh_token=([^;]*)/)?.[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/api/users/me",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns the current user', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().email).to.eql('nam@example.com');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh (rotate)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{host}}/api/auth/refresh",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "No body. The cookie jar sends the refresh_token cookie that Login stored."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rotation succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.not.have.property('refreshToken');",
                  "});",
                  "",
                  "const rotated = (pm.response.headers.get('Set-Cookie') || '').match(/refresh_token=([^;]*)/)?.[1];",
                  "",
                  "pm.test('a new refresh cookie replaces the old one', function () {",
                  "    pm.expect(rotated).to.be.a('string').and.not.empty;",
                  "    pm.expect(rotated).to.not.eql(pm.collectionVariables.get('currentRefreshToken'));",
                  "});",
                  "",
                  "// Keep the token we just spent: 'Reuse a rotated refresh token' replays it.",
                  "pm.collectionVariables.set('oldRefreshToken', pm.collectionVariables.get('currentRefreshToken'));",
                  "pm.collectionVariables.set('currentRefreshToken', rotated);",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Error cases",
      "description": "Each request asserts the exact error code. Runs after '1. Session', which sets oldRefreshToken.",
      "item": [
        {
          "name": "Refresh without cookie",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{host}}/api/auth/refresh",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "The cookie jar is disabled for this request (Settings tab), so no cookie is sent."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 with AUTH_004', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().code).to.eql('AUTH_004');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reuse a rotated refresh token",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "refresh_token={{oldRefreshToken}}"
              }
            ],
            "url": {
              "raw": "{{host}}/api/auth/refresh",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Replays the token that Refresh (rotate) already revoked. The cookie jar is disabled so only the hand-written Cookie header is sent."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a revoked token is rejected with AUTH_006', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().code).to.eql('AUTH_006');",
                  "});",
                  "",
                  "// Known limit: the token that replaced it stays valid. Reuse detection is in the backlog."
                ]
              }
            }
          ]
        },
        {
          "name": "No access token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/api/users/me",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 with AUTH_002 on the called path', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().code).to.eql('AUTH_002');",
                  "    pm.expect(pm.response.json().path).to.eql('/api/users/me');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed access token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-jwt"
              }
            ],
            "url": {
              "raw": "{{host}}/api/users/me",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 with AUTH_002 on the called path', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().code).to.eql('AUTH_002');",
                  "    pm.expect(pm.response.json().path).to.eql('/api/users/me');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong signature",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjk5OTk5OTk5OTl9.wrong_signature_here"
              }
            ],
            "url": {
              "raw": "{{host}}/api/users/me",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 with AUTH_002 on the called path', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().code).to.eql('AUTH_002');",
                  "    pm.expect(pm.response.json().path).to.eql('/api/users/me');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Logout",
      "description": "Both requests clear the refresh cookie.",
      "item": [
        {
          "name": "Logout current device",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{host}}/api/auth/logout",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "No body. Needs the access token (collection auth) and the refresh_token cookie (cookie jar)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 and the refresh cookie is cleared', function () {",
                  "    pm.response.to.have.status(204);",
                  "    const header = pm.response.headers.get('Set-Cookie');",
                  "    pm.expect(header).to.include('Max-Age=0');",
                  "    pm.expect(header).to.include('Path=/api/auth');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout all devices",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{host}}/api/auth/logout-all",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "auth",
                "logout-all"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 and the refresh cookie is cleared', function () {",
                  "    pm.response.to.have.status(204);",
                  "    const header = pm.response.headers.get('Set-Cookie');",
                  "    pm.expect(header).to.include('Max-Age=0');",
                  "    pm.expect(header).to.include('Path=/api/auth');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Manual (not for Runner)",
      "description": "Not for the Runner. Needs the app restarted with a short access token lifetime.",
      "item": [
        {
          "name": "Expired access token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/api/users/me",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "Restart the app with APP_JWT_ACCESS_TOKEN_EXPIRATION=10s, send Login, wait ten seconds, then send this."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 with AUTH_003 on the called path', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().code).to.eql('AUTH_003');",
                  "    pm.expect(pm.response.json().path).to.eql('/api/users/me');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
